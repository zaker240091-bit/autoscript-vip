#!/bin/bash
clear
echo -e "\033[0;34m◇━━━━━━━━━━━━━━━━━━━━━━━━━━━◇\033[0m"
echo -e "       SAVED CONFIGS VIEWER       "
echo -e "\033[0;34m◇━━━━━━━━━━━━━━━━━━━━━━━━━━━◇\033[0m"
echo ""

if [ ! -d /root/configs ] || [ -z "$(ls /root/configs 2>/dev/null)" ]; then
    echo -e "\033[0;31mNo saved configs found in /root/configs/\033[0m"
    echo ""
    read -n 1 -s -r -p "Press any key to back on menu"
    menu
fi

echo -e "\033[0;32mSaved configs:\033[0m"
echo ""
ls /root/configs/ | nl
echo ""
read -p "Select number to view (0 to back): " num

if [[ $num == "0" ]]; then
    menu
fi

file=$(ls /root/configs/ | sed -n "${num}p")
if [ -z "$file" ]; then
    echo "Invalid selection."
    sleep 1
    cekconfig
fi

clear
echo -e "\033[0;34m◇━━━━━━━━━━━━━━━━━━━━━━━━━━━◇\033[0m"
cat /root/configs/$file
echo -e "\033[0;34m◇━━━━━━━━━━━━━━━━━━━━━━━━━━━◇\033[0m"
echo ""
read -n 1 -s -r -p "Press any key to back"
menu
